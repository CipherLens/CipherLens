52-+/* Test that a truncated PQC hybrid KeyShare in a ServerHello does not cause a
53-+ * heap use-after-free during cleanup. A malicious server sends
54-+ * SECP256R1MLKEM768 with only 10 bytes of key exchange data (expected: 1120+).
55:+ * This exercises the error path in TLSX_KeyShare_ProcessPqcHybridClient().
56-+ * Under ASAN the UAF manifests as ForceZero writing to freed KyberKey memory
57-+ * during wolfSSL_free -> TLSX_FreeAll -> TLSX_KeyShare_FreeAll. */
58-+#if defined(WOLFSSL_TLS13) && !defined(NO_WOLFSSL_CLIENT) && \
59-+    defined(WOLFSSL_HAVE_MLKEM) && defined(WOLFSSL_PQC_HYBRIDS) && \
60-+    !defined(WOLFSSL_NO_ML_KEM_768) && defined(HAVE_ECC) && \
61-+    !defined(WOLFSSL_MLKEM_NO_DECAPSULATE) && \
62-+    !defined(WOLFSSL_MLKEM_NO_MAKE_KEY)
63-+/* Called when writing - discard output. */
64-+static int PqcHybridUafSend(WOLFSSL* ssl, char* buf, int sz, void* ctx)
65-+{
66-+    (void)ssl;
67-+    (void)buf;
68-+    (void)ctx;
69-+    return sz;
70-+}
71-+/* Called when reading - feed from buffer. */
72-+static int PqcHybridUafRecv(WOLFSSL* ssl, char* buf, int sz, void* ctx)
73-+{
74-+    WOLFSSL_BUFFER_INFO* msg = (WOLFSSL_BUFFER_INFO*)ctx;
75-+    int len = (int)msg->length;
76-+
77-+    (void)ssl;
78-+
79-+    if (len > sz)
80-+        len = sz;
81-+    XMEMCPY(buf, msg->buffer, len);
82-+    msg->buffer += len;
83-+    msg->length -= len;
84-+    return len;
85-+}
86-+#endif
